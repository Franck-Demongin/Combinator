import { Button, CheckBox, HorizontalBox, LineEdit, ListView, Palette, ProgressIndicator, ScrollView, StandardButton, VerticalBox } from "std-widgets.slint";
import { ToastOverlay } from "toast/toast.slint";
export { ToastTiming, ToastState } from "toast/toast.slint";

global Layout {
    out property <length> padding: 16px;
    out property <length> spacing: 12px;
    out property <length> gap: 8px;
    out property <length> radius: 6px;
    out property <length> row-height: 24px;
}

export component MainWindow inherits Window {
    title: "Combinator";

    min-width: 760px;
    min-height: 460px;
    preferred-width: 860px;
    preferred-height: 520px;

    in-out property <[string]> source-items;
    in-out property <string> output-path: "combinator.pdf";
    in-out property <bool> force-overwrite: false;
    in-out property <bool> busy: false;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "Pret.";
    in-out property <bool> output-ready: false;
    in property <string> report-text: "";

    callback show-success();
    callback show-warning();
    callback show-error();
    callback add-files();
    callback add-directory();
    callback clear-sources();
    callback choose-output();
    callback generate();
    callback open-output-file();
    callback open-output-folder();
    callback open-report();

    VerticalBox {
        padding: Layout.padding;
        spacing: Layout.spacing;

        HorizontalBox {
            vertical-stretch: 0;
            spacing: Layout.gap;

            Image {
                source: @image-url("../../../assets/icons/combinator-64.png");
                width: 48px;
                height: 48px;
                image-fit: contain;
            }

            VerticalBox {
                padding: 0px;
                spacing: 2px;

                Text {
                    text: "Combinator";
                    font-size: 20px;
                    font-weight: 700;
                }

                Text {
                    text: "Composition de sources sur planches A4";
                    font-size: 12px;
                    color: Palette.foreground;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        HorizontalBox {
            spacing: Layout.gap;

            Button {
                text: "Ajouter des fichiers";
                enabled: !root.busy;
                clicked => { root.add-files(); }
            }

            Button {
                text: "Ajouter un dossier";
                enabled: !root.busy;
                clicked => { root.add-directory(); }
            }

            Button {
                text: "Vider";
                enabled: !root.busy;
                clicked => { root.clear-sources(); }
            }
        }

        Text {
            text: "Sources";
            font-weight: 600;
        }

        Rectangle {
            border-color: Palette.border;
            border-width: 1px;
            border-radius: Layout.radius;
            vertical-stretch: 1;

            ListView {
                for item in root.source-items : Text {
                    text: item;
                    height: Layout.row-height;
                    width: parent.width;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalBox {
            spacing: Layout.gap;

            Text {
                text: "Sortie";
                vertical-alignment: center;
            }

            LineEdit {
                horizontal-stretch: 1;
                text <=> root.output-path;
                enabled: !root.busy;
            }

            Button {
                text: "Parcourir";
                enabled: !root.busy;
                clicked => { root.choose-output(); }
            }
        }

        HorizontalBox {
            spacing: Layout.gap;

            CheckBox {
                text: "Forcer l'ecrasement";
                checked <=> root.force-overwrite;
                enabled: !root.busy;
            }
        }

        ProgressIndicator {
            height: 8px;
            progress: root.progress;
            indeterminate: root.busy;
        }

        Text {
            text: root.status-text;
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: Layout.gap;

            Button {
                text: "Rapport";
                visible: root.output-ready;
                enabled: root.output-ready;
                clicked => { root.open-report(); }
            }

            Button {
                text: "Ouvrir le fichier";
                visible: root.output-ready;
                enabled: root.output-ready;
                clicked => { root.open-output-file(); }
            }

            Button {
                text: "Ouvrir le dossier";
                visible: root.output-ready;
                enabled: root.output-ready;
                clicked => { root.open-output-folder(); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Generer";
                primary: true;
                enabled: !root.busy && root.source-items.length > 0;
                clicked => { root.generate(); }
            }
        }
    }

    ToastOverlay {
        available-width: root.width;
        spacing: Layout.gap;
    }
}

export component ReportDialog inherits Dialog {
    title: "Rapport";
    min-width: 620px;
    min-height: 420px;
    preferred-width: 620px;
    preferred-height: 480px;

    in property <string> report-text;

    ScrollView {
        width: parent.width;
        height: parent.height;

        Text {
            text: root.report-text;
            wrap: word-wrap;
            width: parent.width;
        }
    }

    StandardButton {
        kind: ok;
    }
}
