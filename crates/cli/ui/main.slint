import { Button, CheckBox, HorizontalBox, LineEdit, ListView, Palette, ProgressIndicator, ScrollView, StandardButton, VerticalBox } from "std-widgets.slint";
import { ToastOverlay } from "toast/toast.slint";
export { ToastTiming, ToastState } from "toast/toast.slint";

export struct SourceItem {
    path: string,
    name: string,
    display-name: string,
    display-path: string,
}

export global SourceTransfer {
    pure callback path-to-transfer(string) -> data-transfer;
    pure callback transfer-to-path(data-transfer) -> string;
}

global Layout {
    out property <length> padding: 16px;
    out property <length> spacing: 12px;
    out property <length> gap: 8px;
    out property <length> radius: 6px;
    out property <length> row-height: 24px;
}

export component MainWindow inherits Window {
    title: "Combinator";

    min-width: 760px;
    min-height: 720px;
    preferred-width: 860px;
    preferred-height: 760px;

    in-out property <[SourceItem]> source-items;
    in-out property <string> output-path: "combinator.pdf";
    in-out property <bool> force-overwrite: false;
    in-out property <bool> busy: false;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "Pret.";
    in-out property <bool> output-ready: false;
    in property <string> report-text: "";

    callback show-success();
    callback show-warning();
    callback show-error();
    callback add-files();
    callback add-directory();
    callback clear-sources();
    callback remove-source(int);
    callback source-drag-finished(int, DragAction);
    callback source-drop-target(int, data-transfer);
    callback choose-output();
    callback generate();
    callback open-output-file();
    callback open-output-folder();
    callback open-report();

    VerticalBox {
        padding: Layout.padding;
        spacing: Layout.spacing;

        HorizontalBox {
            vertical-stretch: 0;
            spacing: Layout.gap;

            Image {
                source: @image-url("../../../assets/icons/combinator-64.png");
                width: 48px;
                height: 48px;
                image-fit: contain;
            }

            VerticalBox {
                padding: 0px;
                spacing: 2px;

                Text {
                    text: "Combinator";
                    font-size: 20px;
                    font-weight: 700;
                }

                Text {
                    text: "Composition de sources sur planches A4";
                    font-size: 12px;
                    color: Palette.foreground;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        HorizontalBox {
            spacing: Layout.gap;

            Button {
                text: "Ajouter des fichiers";
                icon: @image-url("../../../assets/icons/ui/file-open.svg");
                icon-size: 16px;
                colorize-icon: true;
                enabled: !root.busy;
                clicked => { root.add-files(); }
            }

            Button {
                text: "Ajouter un dossier";
                icon: @image-url("../../../assets/icons/ui/folder-open.svg");
                icon-size: 16px;
                colorize-icon: true;
                enabled: !root.busy;
                clicked => { root.add-directory(); }
            }

            Button {
                text: "Vider";
                icon: @image-url("../../../assets/icons/ui/delete.svg");
                icon-size: 16px;
                colorize-icon: true;
                enabled: !root.busy;
                clicked => { root.clear-sources(); }
            }
        }

        Text {
            text: "Sources";
            font-weight: 600;
        }

        Rectangle {
            border-color: Palette.border;
            border-width: 1px;
            border-radius: Layout.radius;
            vertical-stretch: 1;
            min-height: 280px;

            ListView {
                for item[index] in root.source-items : Rectangle {
                    height: 48px;
                    width: parent.width;
                    opacity: drag.dragging ? 0.5 : 1.0;
                    background: drop.has-drag ? #e8f0fe : transparent;
                    border-color: drop.has-drag ? #9bb4e0 : transparent;
                    border-width: drop.has-drag ? 1px : 0px;
                    border-radius: 4px;

                    drop := DropArea {
                        width: parent.width;
                        height: parent.height;
                        can-drop(event) => {
                            SourceTransfer.transfer-to-path(event.data) != item.path
                                ? DragAction.move
                                : DragAction.none
                        }
                        dropped(event) => {
                            root.source-drop-target(index, event.data);
                            return event.proposed-action;
                        }

                        HorizontalBox {
                            spacing: Layout.gap;
                            padding: Layout.gap;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 4px;

                                Text {
                                    text: "≡";
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                }

                                drag := DragArea {
                                    width: parent.width;
                                    height: parent.height;
                                    data: SourceTransfer.path-to-transfer(item.path);
                                    allow-move: true;
                                    drag-finished(action) => {
                                        root.source-drag-finished(index, action);
                                    }
                                }
                            }

                            VerticalBox {
                                padding: 0px;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: item.display-name;
                                    font-size: 14px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: item.display-path;
                                    font-size: 11px;
                                    color: Palette.foreground;
                                }
                            }

                            Button {
                                text: "×";
                                width: 28px;
                                enabled: !root.busy;
                                clicked => { root.remove-source(index); }
                            }

                            Rectangle {
                                width: 8px;
                            }
                        }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: Layout.gap;

            Text {
                text: "Sortie";
                vertical-alignment: center;
            }

            LineEdit {
                horizontal-stretch: 1;
                text <=> root.output-path;
                enabled: !root.busy;
            }

            Button {
                text: "Parcourir";
                icon: @image-url("../../../assets/icons/ui/folder-open.svg");
                icon-size: 16px;
                colorize-icon: true;
                enabled: !root.busy;
                clicked => { root.choose-output(); }
            }
        }

        HorizontalBox {
            spacing: Layout.gap;

            CheckBox {
                text: "Forcer l'ecrasement";
                checked <=> root.force-overwrite;
                enabled: !root.busy;
            }
        }

        ProgressIndicator {
            height: 8px;
            progress: root.progress;
            indeterminate: root.busy;
            visible: root.busy;
        }

        Text {
            text: root.status-text;
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: Layout.gap;

            Button {
                text: "Rapport";
                icon: @image-url("../../../assets/icons/ui/document-properties.svg");
                icon-size: 16px;
                colorize-icon: true;
                visible: root.output-ready;
                enabled: root.output-ready;
                clicked => { root.open-report(); }
            }

            Button {
                text: "Ouvrir le fichier";
                icon: @image-url("../../../assets/icons/ui/file-open.svg");
                icon-size: 16px;
                colorize-icon: true;
                visible: root.output-ready;
                enabled: root.output-ready;
                clicked => { root.open-output-file(); }
            }

            Button {
                text: "Ouvrir le dossier";
                icon: @image-url("../../../assets/icons/ui/folder-open.svg");
                icon-size: 16px;
                colorize-icon: true;
                visible: root.output-ready;
                enabled: root.output-ready;
                clicked => { root.open-output-folder(); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Generer";
                icon: @image-url("../../../assets/icons/ui/document-save.svg");
                icon-size: 16px;
                colorize-icon: true;
                primary: true;
                enabled: !root.busy && root.source-items.length > 0;
                clicked => { root.generate(); }
            }
        }
    }

    ToastOverlay {
        available-width: root.width;
        spacing: Layout.gap;
    }
}

export component ReportDialog inherits Dialog {
    title: "Rapport";
    min-width: 620px;
    min-height: 420px;
    preferred-width: 620px;
    preferred-height: 480px;

    in property <string> report-text;

    ScrollView {
        width: parent.width;
        height: parent.height;

        Text {
            text: root.report-text;
            wrap: word-wrap;
            width: parent.width;
        }
    }

    StandardButton {
        kind: ok;
    }
}
